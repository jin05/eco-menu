# =============================================
# AIエコ献立 - Environment Variables
# このファイルを .env.local にコピーして使用してください
# =============================================

# -----------------------------------------
# Supabase Configuration
# Supabase Dashboard > Project Settings > API から取得
# -----------------------------------------

# Project URL (公開可)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Key (公開可 - RLSで保護されている)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (非公開 - サーバーサイドのみで使用)
# 注意: この鍵はRLSをバイパスするため、絶対にクライアントに公開しないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------
# Anthropic Claude Configuration
# https://console.anthropic.com/settings/keys から取得
# -----------------------------------------

# Anthropic API Key (非公開 - サーバーサイドのみで使用)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -----------------------------------------
# Application Settings (Optional)
# -----------------------------------------

# アプリケーションのベースURL
NEXT_PUBLIC_APP_URL=http://localhost:3000
